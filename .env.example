# BL-005 uses the server-only Supabase names below. Real values are not
# required for deterministic unit/contract tests or production builds.
#
# Keep real values in ignored local environment files and in environment-scoped
# platform settings. Never expose these values through NEXT_PUBLIC_ names.
#
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# BL-009 uses the server-only model configuration names below for a bounded,
# explicitly budgeted classification experiment. Put real values only in an
# ignored .env.local file. The model receives no disposal guidance, tools,
# database credential, or authority to create instructions.
MODEL_PROVIDER=
MODEL_API_KEY=
MODEL_ID=
MODEL_REASONING_EFFORT=
