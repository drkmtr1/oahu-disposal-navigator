{
  "name": "oahu-disposal-navigator",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.17.1 <23",
    "npm": ">=10.9.2 <11"
  },
  "packageManager": "npm@10.9.2",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "validate:data": "node scripts/validate-source-inventory.mjs && node scripts/validate-v1-dataset.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "audit:dependencies": "npm audit --audit-level=high"
  },
  "dependencies": {
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "typescript": "6.0.2"
  }
}
